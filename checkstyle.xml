<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
          "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
          "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="TreeWalker">
        <!-- Validates that @param names match method arguments exactly, and flags missing tags -->
        <module name="JavadocMethod">
            <property name="accessModifiers" value="public, protected"/>
            <property name="allowMissingParamTags" value="false"/>
            <property name="allowMissingReturnTag" value="false"/>
            <property name="allowedAnnotations" value="Override"/>
            <property name="validateThrows" value="false"/>
        </module>

        <!-- Requires that public and protected methods have a Javadoc comment -->
        <module name="MissingJavadocMethod">
            <property name="scope" value="protected"/>
            <property name="tokens" value="METHOD_DEF"/>
            <property name="allowedAnnotations" value="Override, Deprecated"/>
        </module>

        <!-- Ensures tags like @param and @return are not empty -->
        <module name="NonEmptyAtclauseDescription"/>

        <!-- Enforces standard tag order: @param -> @return -> @throws -> @deprecated -->
        <module name="AtclauseOrder">
            <property name="tagOrder" value="@param, @return, @throws, @deprecated"/>
            <property name="target" value="CLASS_DEF, INTERFACE_DEF, ENUM_DEF, METHOD_DEF, VARIABLE_DEF"/>
        </module>

        <!-- Enforces clean indentation when Javadoc tag descriptions span multiple lines -->
        <module name="JavadocTagContinuationIndentation">
            <property name="offset" value="4"/>
        </module>

        <!-- Checks tags formatting, unclosed tags, valid HTML -->
        <module name="JavadocStyle">
            <property name="checkFirstSentence" value="false"/>
            <property name="checkEmptyJavadoc" value="true"/>
        </module>

        <!-- Forbids wildcard imports like import java.util.* -->
        <module name="AvoidStarImport">
            <property name="allowClassImports" value="false"/>
            <property name="allowStaticMemberImports" value="false"/>
        </module>
    </module>
</module>
