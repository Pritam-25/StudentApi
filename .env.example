# ==============================================================================
# Local Development Environment Template (.env.example)
# Copy this file to .env and customize with your local configuration:
#   cp .env.example .env
# ==============================================================================

# Active Spring Profile (dev for local development with auto-ddl, debug logs, HTTP cookies)
SPRING_PROFILES_ACTIVE=dev

# Server Port (optional, defaults to 8000 if omitted)
PORT=8000

# PostgreSQL Database Connection URL (e.g. Neon serverless, local Postgres, or Docker)
# Format: jdbc:postgresql://<host>:<port>/<database>?user=<username>&password=<password>&sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/studentapi?user=postgres&password=postgres

# 256-bit Base64-encoded secret key for signing JWTs (must be at least 32 characters)
# Generate a new random secret with: openssl rand -base64 32
JWT_SECRET=your-base64-encoded-256-bit-secret-key-must-be-32-chars-or-more

# Optional: JWT Issuer (defaults to api.maityp394.live)
JWT_ISSUER=api.maityp394.live

# Optional: JWT Expiration in milliseconds (defaults to 900000 ms = 15 minutes)
JWT_EXPIRATION_MS=900000

# Allowed CORS Origins (comma-separated origins for local frontend testing, e.g. Next.js on port 3000)
CORS_ALLOWED_ORIGINS=http://localhost:3000, http://localhost:5173

# Cookie Security (false for local HTTP testing; set to true when testing over HTTPS)
COOKIE_SECURE=false

# SQL Logging (true to display formatted SQL statements in console during development)
SHOW_SQL=true
